# Local development defaults use SQLite; override to use PostgreSQL.
DATABASE_URL=sqlite:///./aeropulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RISK_CRITICAL_CYCLES=20
RISK_WATCH_CYCLES=50
# Optional: use a trusted mirror if the NASA URL is unavailable in your network.
# CMAPSS_DATA_URL=https://data.nasa.gov/docs/legacy/CMAPSSData.zip
